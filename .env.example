# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > service_role (NUNCA exponha no client, uso só em API routes)
SUPABASE_SERVICE_ROLE_KEY=

# String aleatória longa, gerada só uma vez (ex: openssl rand -hex 32). Usada para
# assinar o token de sessão do treinamento — trocá-la invalida sessões em andamento.
APP_TOKEN_SECRET=

# Duração real do vídeo em public/videos/treinamento.mp4, em segundos.
# Precisa bater com o arquivo real: é a base da validação anti-fraude no servidor.
TRAINING_VIDEO_DURATION_SECONDS=

# Caminho público do vídeo (arquivo dentro de /public).
NEXT_PUBLIC_TRAINING_VIDEO_SRC=/videos/treinamento.mp4

# Usados no cabeçalho do termo em PDF (relatório admin > botão de baixar termo).
COMPANY_NAME="Fama Transporte Turismo Ltda"
TRAINING_TITLE="Treinamento de Motoristas"
