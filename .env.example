# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > service_role (NUNCA exponha no client, uso só em API routes)
SUPABASE_SERVICE_ROLE_KEY=

# String aleatória longa, gerada só uma vez (ex: openssl rand -hex 32). Usada para
# assinar o token de sessão do treinamento — trocá-la invalida sessões em andamento.
APP_TOKEN_SECRET=

# Duração real do vídeo no YouTube, em segundos (veja em YouTube Studio > Detalhes).
# Precisa bater com o vídeo real: é a base da validação anti-fraude no servidor.
TRAINING_VIDEO_DURATION_SECONDS=

# ID do vídeo de treinamento no YouTube, hospedado como "Não listado" (não Privado —
# vídeo privado não pode ser incorporado). É o trecho depois de "v=" na URL do vídeo
# (ex.: em https://www.youtube.com/watch?v=dQw4w9WgXcQ o ID é dQw4w9WgXcQ), ou o trecho
# depois de "/shorts/" se o vídeo foi enviado como Short (ex.: em
# https://youtube.com/shorts/fddbj4TcmN0 o ID é fddbj4TcmN0).
NEXT_PUBLIC_TRAINING_VIDEO_ID=

# Proporção largura/altura do vídeo. Use "16/9" para vídeo em paisagem ou "9/16" para
# vídeo em retrato (caso comum de um Short). Se não bater com o vídeo real, ele aparece
# com barras pretas ou espremido.
NEXT_PUBLIC_TRAINING_VIDEO_ASPECT_RATIO=16/9

# Usados no cabeçalho do termo em PDF (relatório admin > botão de baixar termo).
COMPANY_NAME="Fama Transporte Turismo Ltda"
TRAINING_TITLE="Treinamento de Motoristas"
